# Copy to .env and fill in, or set these as real environment variables.
# NEVER commit a filled-in copy. .env is gitignored.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Your own Discord user ID (enable Developer Mode in Discord, right-click yourself -> Copy User ID)
# Must be a user the bot can DM (see README: shared guild, or DMs already enabled).
DISCORD_USER_ID=
