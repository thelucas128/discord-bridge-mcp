# Copy to .env (the server auto-loads .env if it sits next to index.js or in
# the cwd), or set these as real environment variables.
# NEVER commit a filled-in copy: .env is gitignored.

# Bot token from https://discord.com/developers/applications
# Your application -> Bot -> Reset Token. Discord shows it once.
# Plain TOKEN= also works, the bridge accepts both names.
DISCORD_TOKEN=

# Your own Discord user ID: Discord Settings -> Advanced -> Developer Mode
# (on desktop), then right-click yourself in chat -> Copy User ID.
# Must be a user the bot can DM (see README: shared guild, or DMs allowed).
DISCORD_USER_ID=

# Optional: tone the agent writes DMs in. Otherwise set once at setup.
DISCORD_PERSONALITY=warm, encouraging, brief, like a friend cheering you on
